# Environment variables for north-star-2.
#
# Copy this file to `.env.local` and fill in the values. `.env*` is gitignored,
# so your real keys never get committed. The main process loads `.env.local` at
# startup, before the Portkey client and execution backend are constructed.

# ---------------------------------------------------------------------------
# LLM gateway (required)
# ---------------------------------------------------------------------------
# API key for the Portkey gateway. `NEXT_apiKey` takes priority; if it's unset
# the app falls back to `PORTKEY_API_KEY`. Set one of them.
NEXT_apiKey=
# PORTKEY_API_KEY=

# ---------------------------------------------------------------------------
# Execution backend (optional — see .plan/006-environments-execution-backend.md)
# ---------------------------------------------------------------------------
# Selects where the agent's machine-touching tools (run_shell + file ops)
# execute. Unset = Local (runs directly on the host, the default behavior).
# Set to a container runtime to sandbox execution in a bind-mounted container.
#   Options: docker | podman
# (Until the settings pane lands, this env var is the only way to switch.)
# COWORK_ENV_RUNTIME=docker

# Container image used when COWORK_ENV_RUNTIME is set. Ignored for Local.
#   Default: node:20-bookworm
# COWORK_ENV_IMAGE=node:20-bookworm

# ---------------------------------------------------------------------------
# System name / branding (optional)
# ---------------------------------------------------------------------------
# The app's customizable name. Drives, at runtime, the on-disk data dir
# (~/.<slug>), the skills lookup dirs (<root>/.<slug>/skills), the SQLite
# filename (<slug>.db), the agent container name prefix, and the window title.
# At package time, `pnpm dist` also derives the app's productName and appId from
# it (see scripts/dist.mjs). Change it and rebuild to rebrand the whole app.
#   Default: cowork  (surfaces as "Cowork" / "~/.cowork")
# NEXT_system_name=cowork

# The main agent's brand name, used in per-view empty-session headings
# (e.g. "North Star - Chat").
#   Default: North Star
# MAIN_AGENT_NAME=North Star

# ---------------------------------------------------------------------------
# Brand theme / colors (optional)
# ---------------------------------------------------------------------------
# Recolor the UI per client without touching code. Both take a hex color and
# default to the shipped palette, so leaving them unset (or at these defaults)
# reproduces the current look exactly.
#
# IMPORTANT: QUOTE the value. dotenv treats an unquoted `#` as a comment, so
# `NEXT_accent_color=#2563eb` parses to an EMPTY string (→ no override, no
# change). Use `NEXT_accent_color="#2563eb"` (or drop the hash: `2563eb`).
#
# NEXT_accent_color  — the primary/brand hue (buttons, active states, the sidebar
#                      brand accent). The app keeps its tuned light/dark lightness
#                      ladder and just rotates to this hue + matches its saturation.
#   Default: #008236  (the green primary)
# NEXT_accent_color="#008236"
#
# NEXT_neutral_color — the surface/background base (backgrounds, cards, borders,
#                      muted text). Pass a near-gray for a subtle tint; pure gray
#                      = today's neutral UI.
#   Default: #0a0a0a  (near-black neutral)
# NEXT_neutral_color="#0a0a0a"
